{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Format GDScript Code",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "./scripts/commands.ps1",
                "format"
            ],
            "group": "build",
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": false,
                "panel": "shared",
                "showReuseMessage": false
            },
            "problemMatcher": []
        },
        {
            "label": "Check Code Quality",
            "type": "shell",
            "command": "powershell",
            "args": [
                "-ExecutionPolicy", "Bypass",
                "-File", "./scripts/commands.ps1",
                "analyze"
            ],
            "group": "build"
        }
    ]
}
