code = "shader_type spatial;
render_mode blend_mix, depth_draw_opaque, cull_back, diffuse_lambert, specular_schlick_ggx;

uniform vec4 BackgroundColor : source_color;
uniform vec4 ForegroundColor : source_color;
uniform float LevelDepth;



void vertex() {
// Input:3
	float n_out3p0 = 0.0;


// Input:2
	vec3 n_out2p0 = VERTEX;


// TransformVectorMult:4
	vec3 n_out4p0 = ( * vec4(n_out2p0, 1.0)).xyz;


// VectorOp:5
	vec3 n_out5p0 = n_out4p0 - n_out2p0;


// Output:0
	COLOR.rgb = n_out5p0;


}

void fragment() {
// ColorParameter:6
	vec4 n_out6p0 = BackgroundColor;


// ColorParameter:5
	vec4 n_out5p0 = ForegroundColor;


// Input:3
	vec4 n_out3p0 = COLOR;


// VectorDecompose:4
	float n_out4p0 = vec3(n_out3p0.xyz).x;
	float n_out4p1 = vec3(n_out3p0.xyz).y;
	float n_out4p2 = vec3(n_out3p0.xyz).z;


// FloatParameter:10
	float n_out10p0 = LevelDepth;


// FloatOp:8
	float n_out8p0 = n_out4p2 / n_out10p0;


// FloatOp:9
	float n_in9p1 = 0.50000;
	float n_out9p0 = n_out8p0 + n_in9p1;


// Mix:7
	float n_out7p0 = mix(n_out6p0.x, n_out5p0.x, n_out9p0);


// Output:0
	ALBEDO = vec3(n_out7p0);


}
